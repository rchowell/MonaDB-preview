{
  "name": "@mona/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./generated/openapi.ts",
    "./client": "./generated/client.ts",
    "./openapi.json": "./generated/openapi.json"
  },
  "scripts": {
    "build": "tsp compile . && node ./scripts/generate-ts.mjs && node ./scripts/generate-rust.mjs",
    "compile": "tsp compile .",
    "generate:ts": "node ./scripts/generate-ts.mjs",
    "generate:rust": "node ./scripts/generate-rust.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.13.0",
    "@typespec/http": "^1.13.0",
    "@typespec/openapi": "^1.13.0",
    "@typespec/openapi3": "^1.13.0",
    "@typespec/rest": "^0.83.0",
    "openapi-typescript": "^7.9.1"
  }
}
